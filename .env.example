# PyAssist Environment Configuration
# Copy this file to .env before starting the server

APP_ENV="development"
SECRET_KEY="generate-a-cryptographically-secure-random-32-byte-secret-key"
PYASSIST_DATABASE_URL="sqlite:///./pyassist.db"

# Cookie Security (set to true in HTTPS production deployments)
COOKIE_SECURE="false"

# Optional: set GEMINI_API_KEY as a server-side Replit Secret to enable all five AI modes.
# Without it, Ask mode uses the local knowledge base; other modes report that Gemini is unavailable.
GEMINI_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-3.1-flash-lite"

# Rate Limiting Defaults
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_CHAT="30/minute"

# Server Port (Replit webview uses 5000)
PORT=5000
