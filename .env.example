# PyAssist Environment Configuration
# Copy this file to .env before starting the server

APP_ENV="development"
SECRET_KEY="generate-a-cryptographically-secure-random-32-byte-secret-key"
DATABASE_URL="sqlite:///./pyassist.db"

# Cookie Security (set to true in HTTPS production deployments)
COOKIE_SECURE="false"

# Rate Limiting Defaults
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_CHAT="30/minute"

# Server Port
PORT=3000
